# Telegram Notification Credentials (Optional for local generation, required for daily Telegram alerts)
# 1. Obtain TELEGRAM_BOT_TOKEN from @BotFather on Telegram.
# 2. Obtain TELEGRAM_CHAT_ID from @userinfobot or your channel/group ID (e.g., -100xxxxxxxxxx).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Set to "true" if you want the telegram script to exit with error when secrets are missing (useful in CI)
TELEGRAM_REQUIRED=false
